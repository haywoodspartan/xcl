<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- xcl.exe's application manifest. heapType: the process heap is a segment heap. The graphics
     driver's shader compiler, the D3D12 runtime, Media Foundation and the title's own threads all
     allocate from the process heap; as an NT heap it has one lock, and with pipelines of a retail
     title compiling on ten threads its audio and render threads stood at that lock. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
